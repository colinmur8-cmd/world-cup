# Discord
DISCORD_TOKEN=
PONGBOT_CHANNEL_ID=
BOT_OWNER_USER_ID=

# Smarkets — the REST API is session-based. Log in with your account
# credentials (the account approved for API access); the bot mints a
# Session-Token at startup and refreshes it automatically.
SMARKETS_USERNAME=
SMARKETS_PASSWORD=
# Optional: paste a pre-minted session token instead of username/password.
SMARKETS_API_TOKEN=

# Stake / safety limits
UNIT_SIZE=200
MIN_PRICE=1.50
MAX_PRICE=2.50
MIN_LIQUIDITY=10
MAX_ORDERS=20
MAX_LINE_OVER=84.5
MIN_LINE_UNDER=59.5
LINE_CANCEL_THRESHOLD=20

# Mode — set to false to place real orders
PAPER_MODE=true
